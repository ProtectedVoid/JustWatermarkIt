<?xml version="1.0" encoding="utf-8"?>
<!--
  MainWindow.xaml : la page UNIQUE de l'application.
  Elle ne contient AUCUNE logique : chaque contrôle est relié (« bindé ») à une propriété
  ou à une commande du ViewModel, qui lui-même appelle ta bibliothèque.

  Notions utilisées ici :
  - {x:Bind ViewModel.Xxx}           : relie le contrôle à la propriété Xxx du ViewModel
                                       (vérifié à la compilation : une faute de frappe = erreur de build).
  - Mode=OneWay                      : le contrôle se met à jour quand la propriété change.
  - Mode=TwoWay                      : en plus, la propriété suit ce que fait l'utilisateur (slider, case à cocher).
  - Command="{x:Bind ViewModel.XxxCommand}" : le bouton exécute la commande du ViewModel
                                       (et se grise tout seul quand la commande n'est pas exécutable).
-->
<Window
    x:Class="Watermarker.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Watermarker.WinUI"
    xmlns:vm="using:Watermarker.ViewModels.ViewModels"
    Title="Watermarker">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- 0 : formulaire -->
            <RowDefinition Height="Auto" />
            <!-- 1 : boutons -->
            <RowDefinition Height="Auto" />
            <!-- 2 : progression -->
            <RowDefinition Height="*" />
            <!-- 3 : résultats (prend la place restante) -->
        </Grid.RowDefinitions>

        <!-- ===== 0. Formulaire (grisé pendant le traitement) ===== -->
        <StackPanel Grid.Row="0" Spacing="16" IsEnabled="{x:Bind ViewModel.IsNotRunning, Mode=OneWay}">

            <!-- Photos à traiter -->
            <StackPanel Spacing="4">
                <TextBlock Text="Photos à traiter" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" IsReadOnly="True"
                             PlaceholderText="Choisir le dossier des photos"
                             Text="{x:Bind ViewModel.SourceFolder, Mode=OneWay}" />
                    <Button Grid.Column="1" Content="Choisir…"
                            Command="{x:Bind ViewModel.PickSourceFolderCommand}" />
                </Grid>
            </StackPanel>

            <!-- Watermark -->
            <StackPanel Spacing="4">
                <TextBlock Text="Watermark" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" IsReadOnly="True"
                             PlaceholderText="Choisir l'image du watermark"
                             Text="{x:Bind ViewModel.WatermarkFile, Mode=OneWay}" />
                    <Button Grid.Column="1" Content="Choisir…"
                            Command="{x:Bind ViewModel.PickWatermarkFileCommand}" />
                </Grid>
                <TextBlock FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Un PNG avec fond transparent donne le meilleur résultat." />
            </StackPanel>

            <!-- Opacité -->
            <StackPanel Spacing="4">
                <TextBlock Text="Opacité" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0" Minimum="0" Maximum="100" StepFrequency="1"
                            Value="{x:Bind ViewModel.OpacityPercent, Mode=TwoWay}" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                               Text="{x:Bind ViewModel.OpacityLabel, Mode=OneWay}" />
                </Grid>
            </StackPanel>

            <!-- Mode : l'index sélectionné (0 = Large, 1 = Coin) est relié à ViewModel.ModeIndex -->
            <RadioButtons Header="Mode" MaxColumns="2"
                          SelectedIndex="{x:Bind ViewModel.ModeIndex, Mode=TwoWay}">
                <x:String>Large</x:String>
                <x:String>Coin</x:String>
            </RadioButtons>

            <!-- Dossier de sortie -->
            <StackPanel Spacing="4">
                <TextBlock Text="Dossier de sortie" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" IsReadOnly="True"
                             PlaceholderText="Choisir le dossier de sortie"
                             Text="{x:Bind ViewModel.DestinationFolder, Mode=OneWay}" />
                    <Button Grid.Column="1" Content="Choisir…"
                            Command="{x:Bind ViewModel.PickDestinationFolderCommand}" />
                </Grid>
            </StackPanel>

            <!-- Options -->
            <StackPanel Spacing="4">
                <CheckBox Content="Renommer les fichiers (w_[nom])"
                          IsChecked="{x:Bind ViewModel.RenameOutputs, Mode=TwoWay}" />
                <CheckBox Content="Déplacer les originaux après traitement"
                          IsChecked="{x:Bind ViewModel.MoveOriginals, Mode=TwoWay}" />

                <!-- Ce bloc est grisé tant que la case ci-dessus n'est pas cochée -->
                <Grid ColumnSpacing="8" Margin="28,0,0,0"
                      IsEnabled="{x:Bind ViewModel.MoveOriginals, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" IsReadOnly="True"
                             PlaceholderText="Choisir le dossier des originaux"
                             Text="{x:Bind ViewModel.OriginalsFolder, Mode=OneWay}" />
                    <Button Grid.Column="1" Content="Choisir…"
                            Command="{x:Bind ViewModel.PickOriginalsFolderCommand}" />
                </Grid>
            </StackPanel>
        </StackPanel>

        <!-- ===== 1. Boutons ===== -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Style="{StaticResource AccentButtonStyle}"
                    Content="Lancer le traitement"
                    Command="{x:Bind ViewModel.StartCommand}" />
            <Button Content="Annuler"
                    Command="{x:Bind ViewModel.CancelCommand}" />
        </StackPanel>

        <!-- ===== 2. Progression ===== -->
        <StackPanel Grid.Row="2" Spacing="6">
            <ProgressBar Minimum="0" Maximum="100"
                         Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" />
            <TextBlock FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" />
        </StackPanel>

        <!-- ===== 3. Résultats : une ligne par photo (icône, nom, message) ===== -->
        <ListView Grid.Row="3" SelectionMode="None"
                  ItemsSource="{x:Bind ViewModel.Results}">
            <ListView.ItemTemplate>
                <!-- x:DataType : le type de chaque ligne, nécessaire pour {x:Bind} dans un modèle -->
                <DataTemplate x:DataType="viewmodelsdto:ResultItem">
                    <Grid ColumnSpacing="12" Padding="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="{x:Bind Glyph}"
                                  Foreground="{x:Bind IconBrush}" />
                        <TextBlock Grid.Column="1" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{x:Bind FileName}" />
                        <TextBlock Grid.Column="2" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind Message}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
