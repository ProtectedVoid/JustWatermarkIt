<?xml version="1.0" encoding="utf-8"?>
<!--
  MainWindow.xaml : la page UNIQUE de l'application.
  Elle ne contient AUCUNE logique : chaque contrôle est relié (« bindé ») à une propriété
  ou à une commande du ViewModel, qui lui-même appelle ta bibliothèque.

  Notions utilisées ici :
  - {x:Bind ViewModel.Xxx}           : relie le contrôle à la propriété Xxx du ViewModel
                                       (vérifié à la compilation : une faute de frappe = erreur de build).
  - Mode=OneWay                      : le contrôle se met à jour quand la propriété change.
  - Mode=TwoWay                      : en plus, la propriété suit ce que fait l'utilisateur (slider, case à cocher).
  - Command="{x:Bind ViewModel.XxxCommand}" : le bouton exécute la commande du ViewModel
                                       (et se grise tout seul quand la commande n'est pas exécutable).
-->
<Window
    x:Class="Watermarker.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Watermarker.WinUI"
    xmlns:vm="using:Watermarker.ViewModels.ViewModels"
    xmlns:dto="using:Watermarker.ViewModels.DTO"
    xmlns:helper="using:Watermarker.WinUI.Helpers"
    Title="Watermarker">

    <Grid Padding="24" RowSpacing="16">
        <!-- Une Window n'a pas de propriété Resources : on les place sur le Grid racine. -->
        <Grid.Resources>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- titre -->
            <RowDefinition Height="*" />
            <!-- contenu sur deux colonnes -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource TitleTextBlockStyle}" Text="Watermarker" />

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="460" />
                <!-- gauche : paramètres -->
                <ColumnDefinition Width="*" />
                <!-- droite : progression et résultats -->
            </Grid.ColumnDefinitions>

            <!-- =========================== COLONNE GAUCHE =========================== -->
            <ScrollViewer Grid.Column="0">
                <StackPanel Spacing="16">

                    <!-- Le ContentControl grise tout son contenu pendant le traitement
                         (IsEnabled n'existe pas sur StackPanel ni sur Grid). -->
                    <ContentControl HorizontalContentAlignment="Stretch"
                                    IsEnabled="{x:Bind ViewModel.IsNotRunning, Mode=OneWay}">
                        <StackPanel Spacing="16">

                            <!-- =============== Carte 1 : Fichiers ================= -->
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Fichiers" />

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Photos à traiter" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" IsReadOnly="True"
                                                     PlaceholderText="Choisir le dossier des photos"
                                                     Text="{x:Bind ViewModel.SourceFolder, Mode=OneWay}" />
                                            <Button Grid.Column="1" Content="Choisir…"
                                                    Command="{x:Bind ViewModel.PickSourceFolderCommand}" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Dossier de sortie" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" IsReadOnly="True"
                                                     PlaceholderText="Choisir le dossier de sortie"
                                                     Text="{x:Bind ViewModel.DestinationFolder, Mode=OneWay}" />
                                            <Button Grid.Column="1" Content="Choisir…"
                                                    Command="{x:Bind ViewModel.PickDestinationFolderCommand}" />
                                        </Grid>
                                    </StackPanel>

                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Options" />

                                    <CheckBox Content="Renommer les fichiers (w_[nom])"
                                        IsChecked="{x:Bind ViewModel.RenameOutputs, Mode=TwoWay}" />
                                    <CheckBox Content="Déplacer les originaux après traitement"
                                        IsChecked="{x:Bind ViewModel.MoveOriginals, Mode=TwoWay}" />

                                    <Grid ColumnSpacing="8" Margin="28,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" IsReadOnly="True"
                                            IsEnabled="{x:Bind ViewModel.MoveOriginals, Mode=OneWay}"
                                            PlaceholderText="Choisir le dossier des originaux"
                                            Text="{x:Bind ViewModel.OriginalsFolder, Mode=OneWay}" />
                                        <Button Grid.Column="1" Content="Choisir…"
                                            IsEnabled="{x:Bind ViewModel.MoveOriginals, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.PickOriginalsFolderCommand}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- =============== Carte 2 : Apparence du watermark =============== -->
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Paramètre du watermark" />

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Watermark" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" IsReadOnly="True"
                                                PlaceholderText="Choisir l'image du watermark"
                                                Text="{x:Bind ViewModel.WatermarkFile, Mode=OneWay}" />
                                            <Button Grid.Column="1" Content="Choisir…"
                                                Command="{x:Bind ViewModel.PickWatermarkFileCommand}" />
                                        </Grid>
                                        <TextBlock FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Un PNG avec fond transparent donne le meilleur résultat." />
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Opacité" />
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="56" />
                                            </Grid.ColumnDefinitions>
                                            <Slider Grid.Column="0" Minimum="0" Maximum="100" StepFrequency="1"
                                                    Value="{x:Bind ViewModel.OpacityPercent, Mode=TwoWay}" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                       Text="{x:Bind ViewModel.OpacityLabel, Mode=OneWay}" />
                                        </Grid>
                                    </StackPanel>

                                    <RadioButtons Header="Mode" MaxColumns="2"
                                                  SelectedIndex="{x:Bind ViewModel.ModeIndex, Mode=TwoWay}">
                                        <x:String>Large</x:String>
                                        <x:String>Coin</x:String>
                                    </RadioButtons>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ContentControl>

                    <!-- Boutons d'action : hors du ContentControl, donc « Annuler » reste actif pendant le traitement -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Style="{StaticResource AccentButtonStyle}"
                                Content="Lancer le traitement"
                                Command="{x:Bind ViewModel.StartCommand}" />
                        <Button Content="Annuler"
                                Command="{x:Bind ViewModel.CancelCommand}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- =========================== COLONNE DROITE =========================== -->
            <Grid Grid.Column="1" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!-- progression -->
                    <RowDefinition Height="*" />
                    <!-- résultats -->
                </Grid.RowDefinitions>

                <!-- ============ Carte : Progression ============== -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Progression" />
                        <ProgressBar Minimum="0" Maximum="100"
                                     Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" />
                        <TextBlock FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!-- ============== Carte : Résultats (la liste défile dans la place restante) ============ -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Résultats" />

                        <ListView Grid.Row="1" SelectionMode="None"
                                  ItemsSource="{x:Bind ViewModel.Results}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="dto:ResultItem">
                                    <Grid ColumnSpacing="12" Padding="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="2*" />
                                        </Grid.RowDefinitions>
                                        <FontIcon Grid.Column="0" VerticalAlignment="Center"
                                                  Glyph="{x:Bind helper:DisplayHelper.GetGlyph(Status)}"
                                                  Foreground="{x:Bind helper:DisplayHelper.GetBrush(Status)}" />
                                        <TextBlock Grid.Column="1" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Text="{x:Bind FileName}" />
                                        <TextBlock Grid.Row="1" TextWrapping="Wrap" Grid.ColumnSpan="2" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Text="{x:Bind Message}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
